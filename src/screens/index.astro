---
import ContactSection from '@/components/marketing/ContactSection.astro';
import Hero from '@/components/marketing/Hero.astro';
import PathSplit from '@/components/marketing/PathSplit.astro';
import TrustStrip from '@/components/marketing/TrustStrip.astro';
import WhyIntentD from '@/components/marketing/WhyIntentD.astro';
import { getDictionary } from '@/i18n';
import MarketingLayout from '@/layouts/MarketingLayout.astro';

const t = getDictionary().home;
---

<MarketingLayout
  title={t.metaTitle}
  titleTemplate={false}
  description={t.metaDescription}
  keywords={[...t.keywords]}
>
  <Hero />
  <TrustStrip />
  <PathSplit />
  <WhyIntentD />
  <ContactSection />
</MarketingLayout>
