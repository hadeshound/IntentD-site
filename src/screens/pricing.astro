---
import FaqSection from '@/components/marketing/FaqSection.astro';
import FeatureMatrix from '@/components/marketing/FeatureMatrix.astro';
import PricingGrid from '@/components/marketing/PricingGrid.astro';
import AmbientGlow from '@/components/ui/AmbientGlow.astro';
import Button from '@/components/ui/Button.astro';
import { getDictionary } from '@/i18n';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { fetchPlansSafe } from '@/lib/api/plans';

const { plans, isFallback } = await fetchPlansSafe();

const t = getDictionary().pricing;
---

<MarketingLayout title={t.metaTitle} description={t.metaDescription}>
  <section class="relative overflow-hidden pb-10 pt-16 lg:pb-16 lg:pt-24">
    <div class="hairline-grid-overlay"></div>
    <AmbientGlow class="-left-20 top-0 h-96 w-96" drift />

    <div class="shell grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="flex items-center gap-3">
          <span class="eyebrow">{t.eyebrow}</span>
          <span class="h-px w-12 bg-hairline-strong"></span>
        </p>

        <h1 class="mt-7 text-hero">
          {t.titleBefore} <span class="text-mint-400">{t.titleAccent}</span>
        </h1>

        <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-muted text-pretty">{t.subtitleLong}</p>
      </div>

      <div class="lg:col-span-4 lg:col-start-9 lg:mt-16">
        <div class="surface-card p-7">
          <h2 class="font-display text-lg text-ink">{t.custom.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t.custom.body}</p>
          <Button
            href="/contact?topic=enterprise"
            variant="secondary"
            class="mt-6 w-full"
          >
            {t.custom.cta}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <PricingGrid plans={plans} isFallback={isFallback} showHeading={false} />

  <FeatureMatrix />

  <FaqSection items={[...t.faq]} eyebrow={t.faqEyebrow} title={t.faqTitle} id="pricing-faq" />
</MarketingLayout>
