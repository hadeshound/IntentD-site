---
import AuthShell from '@/components/auth/AuthShell.astro';
import { ResetPasswordForm } from '@/components/auth/ResetPasswordForm';
import { getDictionary } from '@/i18n';
import MarketingLayout from '@/layouts/MarketingLayout.astro';

const t = getDictionary().auth.reset;

const token = Astro.url.searchParams.get('token') ?? '';
---

<MarketingLayout title={t.metaTitle} description={t.metaDescription} noindex>
  <AuthShell eyebrow={t.eyebrow} title={t.title} description={t.description}>
    <ResetPasswordForm token={token} client:load />

    <p slot="footer">
      {t.expired}{' '}
      <a
        href="/auth/forgot-password"
        class="link-underline underline underline-offset-4"
      >
        {t.requestNew}
      </a>
    </p>
  </AuthShell>
</MarketingLayout>
