---
import AuthShell from '@/components/auth/AuthShell.astro';
import { ResetPasswordForm } from '@/components/auth/ResetPasswordForm';
import { getDictionary, getLangFromUrl, getLocalizedPath } from '@/i18n';
import MarketingLayout from '@/layouts/MarketingLayout.astro';

const lang = getLangFromUrl(Astro.url);
const t = getDictionary(lang).auth.reset;

const token = Astro.url.searchParams.get('token') ?? '';
---

<MarketingLayout title={t.metaTitle} description={t.metaDescription} noindex>
  <AuthShell eyebrow={t.eyebrow} title={t.title} description={t.description}>
    <ResetPasswordForm token={token} lang={lang} client:load />

    <p slot="footer">
      {t.expired}{' '}
      <a
        href={getLocalizedPath('/auth/forgot-password', lang)}
        class="link-underline underline underline-offset-4"
      >
        {t.requestNew}
      </a>
    </p>
  </AuthShell>
</MarketingLayout>
