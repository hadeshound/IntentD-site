---
import AuthShell from '@/components/auth/AuthShell.astro';
import { LoginForm } from '@/components/auth/LoginForm';
import { getDictionary, getLangFromUrl, getLocalizedPath } from '@/i18n';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { resolvePostAuthTarget } from '@/lib/utils/redirect';

const lang = getLangFromUrl(Astro.url);
const t = getDictionary(lang).auth.login;

const params = Astro.url.searchParams;
const plan = params.get('plan');

const redirectTo = resolvePostAuthTarget(params.get('redirect'), plan, lang);

// The counterpart link keeps whatever the visitor was on their way to.
const registerBase = getLocalizedPath('/auth/register', lang);
const registerHref =
  redirectTo === getLocalizedPath('/', lang)
    ? registerBase
    : `${registerBase}?redirect=${redirectTo.split('?')[0]}${plan ? `&plan=${plan}` : ''}`;
---

<MarketingLayout title={t.metaTitle} description={t.metaDescription} noindex>
  <AuthShell eyebrow={t.eyebrow} title={t.title} description={t.description}>
    <LoginForm redirectTo={redirectTo} lang={lang} client:load />

    <p slot="footer">
      {t.noAccount}{' '}
      <a href={registerHref} class="link-underline underline underline-offset-4">{t.createAccount}</a>
    </p>

    <div slot="aside" class="surface-card p-8 lg:p-10">
      <div class="ambient-glow -right-16 -top-16 h-56 w-56 bg-mint-500/20"></div>

      <p class="font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-ink-faint">{t.asideTitle}</p>

      <ul class="mt-7 space-y-5 text-[0.9375rem] leading-relaxed text-ink-muted">
        {
          t.aside.map((item) => (
            <li>
              <strong class="text-ink">{item.strong}</strong> {item.body}
            </li>
          ))
        }
      </ul>
    </div>
  </AuthShell>
</MarketingLayout>
