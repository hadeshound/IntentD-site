---
import ContactSection from '@/components/marketing/ContactSection.astro';
import DataBuyerUseCases from '@/components/marketing/DataBuyerUseCases.astro';
import FaqSection from '@/components/marketing/FaqSection.astro';
import HowItWorks from '@/components/marketing/HowItWorks.astro';
import PricingTeaser from '@/components/marketing/PricingTeaser.astro';
import Button from '@/components/ui/Button.astro';
import { getDictionary } from '@/i18n';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { fetchPlansSafe } from '@/lib/api/plans';

const { plans } = await fetchPlansSafe();

const dictionary = getDictionary();
const t = dictionary.buyersPage;
const h1 = dictionary.useCases.title;
const faq = dictionary.faq.landing;

// What a data buyer asks: how anonymity works and what format arrives.
const questions = [faq[1], faq[2]].filter((item): item is NonNullable<typeof item> => Boolean(item));

const FIELDS = ['search_query', 'domain', 'clean_url', 'anon_uid', 'geo_country', 'device_type', 'timestamp', 'lang'];
---

<MarketingLayout title={t.metaTitle} description={t.metaDescription}>
  <section class="relative overflow-hidden pb-16 pt-12 lg:pb-24 lg:pt-24">
    <div class="shell grid items-center gap-12 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <h1 class="text-hero text-balance">{h1}</h1>

        <p class="mt-7 max-w-[34rem] text-lead text-ink-muted text-pretty">{t.subtitle}</p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <Button href="/contact?topic=buy_data" size="lg" class="sm:min-w-[15rem]">{t.ctaPrimary}</Button>
          <Button href="/docs/api" variant="secondary" size="lg">{t.ctaSecondary}</Button>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="surface-card surface-card-accent p-7 lg:p-8">
          <h2 class="text-card-title">{t.deliveryTitle}</h2>

          <dl class="mt-6 divide-y divide-hairline">
            {
              t.delivery.map((row) => (
                <div class="flex items-baseline justify-between gap-6 py-3.5">
                  <dt class="text-sm text-ink-muted">{row.label}</dt>
                  <dd class="text-right font-medium text-ink">{row.value}</dd>
                </div>
              ))
            }
          </dl>

          <p class="mt-6 text-sm text-ink-muted">{t.fieldsLabel}</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              FIELDS.map((field) => (
                <li class="rounded-control border border-hairline bg-white/[0.04] px-2.5 py-1 font-mono text-xs text-ink-muted">
                  {field}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <DataBuyerUseCases />
  <HowItWorks track="buyers" />
  <PricingTeaser plans={plans} />
  <FaqSection items={questions} id="faq" title={t.faqTitle} />

  <ContactSection
    title={t.closing.title}
    body={t.closing.body}
    primary={{ label: t.closing.primary, href: '/contact?topic=buy_data' }}
    secondary={{ label: t.closing.secondary, href: '/contact?topic=enterprise' }}
  />
</MarketingLayout>
