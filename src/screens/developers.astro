---
import { ArrowRight } from 'lucide-react';

import AdvertisingIsDead from '@/components/marketing/AdvertisingIsDead.astro';
import ContactSection from '@/components/marketing/ContactSection.astro';
import FaqSection from '@/components/marketing/FaqSection.astro';
import HowItWorks from '@/components/marketing/HowItWorks.astro';
import Button from '@/components/ui/Button.astro';
import { getDictionary } from '@/i18n';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { DASHBOARD_LINKS } from '@/lib/config/urls';

const dictionary = getDictionary();
const t = dictionary.developersPage;
const faq = dictionary.faq.landing;

// The questions an extension developer asks: ranking, privacy, when payouts start.
const questions = [faq[0], faq[1], faq[3]].filter((item): item is NonNullable<typeof item> => Boolean(item));

const SNIPPET = `// background.js — first line, top level.
// The bundle already carries your keys and configuration.
import './intentd.min.js';`;
---

<MarketingLayout title={t.metaTitle} description={t.metaDescription}>
  <section class="relative overflow-hidden pb-16 pt-12 lg:pb-24 lg:pt-24">
    <div class="shell grid items-center gap-12 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <h1 class="text-hero">
          {t.titleBefore} <span class="text-mint-400">{t.titleAccent}</span> {t.titleAfter}
        </h1>

        <p class="mt-7 max-w-[34rem] text-lead text-ink-muted text-pretty">{t.subtitle}</p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <Button href={`${DASHBOARD_LINKS.register}?role=publisher`} size="lg" class="sm:min-w-[15rem]">
            {t.ctaPrimary}
            <ArrowRight className="h-4 w-4" aria-hidden="true" />
          </Button>
          <Button href="/calculator" variant="secondary" size="lg">{t.ctaSecondary}</Button>
        </div>
      </div>

      <div class="lg:col-span-5">
        <figure class="m-0 overflow-hidden rounded-card border border-hairline bg-carbon-800">
          <figcaption class="border-b border-hairline px-5 py-3 text-sm text-ink-muted">{t.snippetLabel}</figcaption>
          <pre class="whitespace-pre-wrap break-words p-5 font-mono text-[0.8125rem] leading-relaxed text-ink-muted"><code>{SNIPPET}</code></pre>
        </figure>
      </div>
    </div>
  </section>

  <AdvertisingIsDead />
  <HowItWorks track="publishers" />

  <ContactSection
    id="calculator-cta"
    title={t.band.title}
    body={t.band.body}
    primary={{ label: t.band.cta, href: '/calculator' }}
    secondary={null}
  />

  <FaqSection items={questions} id="faq" title={t.faqTitle} />

  <ContactSection
    title={t.closing.title}
    body={t.closing.body}
    primary={{ label: t.closing.primary, href: `${DASHBOARD_LINKS.register}?role=publisher` }}
    secondary={{ label: t.closing.secondary, href: '/contact?topic=monetize_extension' }}
  />
</MarketingLayout>
