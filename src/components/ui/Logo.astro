---
import { cn } from '@/lib/utils/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/* Wordmark. The glyph is three stacked signal bars converging into one stream,
    which is the product in one shape: many browser sessions, one data feed. */}
<span class={cn('inline-flex items-center gap-2.5', className)}>
  <svg viewBox="0 0 28 28" class="h-7 w-7" fill="none" aria-hidden="true" focusable="false">
    <rect x="0.75" y="0.75" width="26.5" height="26.5" rx="7.25" stroke="rgba(255,255,255,0.14)"></rect>
    <path d="M7 9h7" stroke="#34D399" stroke-width="2" stroke-linecap="round"></path>
    <path d="M7 14h11" stroke="#10B981" stroke-width="2" stroke-linecap="round"></path>
    <path d="M7 19h5" stroke="#059669" stroke-width="2" stroke-linecap="round"></path>
    <circle cx="20.5" cy="19" r="2" fill="#6366F1"></circle>
  </svg>

  <span class="font-display text-lg font-bold tracking-tight text-ink">
    Intent<span class="text-mint-400">D</span>
  </span>
</span>
