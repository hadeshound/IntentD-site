---
import { cn } from '@/lib/utils/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/* Wordmark. The glyph is three input lines resolving into a single point:
    many browser sessions, one clean data stream. */}
<span class={cn('inline-flex items-center gap-2.5', className)}>
  <svg viewBox="0 0 100 100" class="h-7 w-7" fill="none" aria-hidden="true" focusable="false">
    <defs>
        <linearGradient id="idg" x1="6" y1="0" x2="94" y2="100" gradientUnits="userSpaceOnUse">
          <stop stop-color="#35C4A6" />
          <stop offset="1" stop-color="#3A8FCB" />
        </linearGradient>
        <clipPath id="idt"><rect x="-2" y="0" width="110" height="39.4" /></clipPath>
        <clipPath id="idb"><rect x="-2" y="60.4" width="110" height="50" /></clipPath>
        <mask id="idm" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
          <rect width="100" height="100" rx="22" fill="#fff" />
          <g stroke="#000" stroke-width="7.2" fill="none">
            <path d="M-2 49.9H67.8" />
            <g clip-path="url(#idt)"><path d="M-2 28.6H40C49 28.6 53 31.5 62 42" /></g>
            <g clip-path="url(#idb)"><path d="M-2 71.2H40C49 71.2 53 68.3 62 57.8" /></g>
          </g>
          <circle cx="82.1" cy="49.9" r="7.2" fill="#000" />
        </mask>
      </defs>
      <rect width="100" height="100" fill="url(#idg)" mask="url(#idm)" />
  </svg>

  <span class="font-display text-[1.1875rem] font-semibold tracking-tight text-ink">IntentD</span>
</span>
