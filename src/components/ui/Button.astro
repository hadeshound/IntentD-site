---
import { buttonStyles, type ButtonSize, type ButtonVariant } from './styles';

interface Props {
  /** Renders a link when set, a <button> otherwise. */
  href?: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className,
  type = 'button',
  ...rest
} = Astro.props;

const classes = buttonStyles(variant, size, className);

// Links leaving this origin get the usual rel; internal ones are plain
// anchors, because Astro has no client-side router to hand them to.
const isExternal = Boolean(href) && !href!.startsWith('/') && !href!.startsWith('#');
---

{
  href ? (
    <a href={href} class={classes} rel={isExternal ? 'noopener noreferrer' : undefined} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
