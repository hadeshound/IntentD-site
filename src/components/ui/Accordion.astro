---
import { Plus } from 'lucide-react';

import type { FaqEntry } from '@/lib/content/faq';
import { cn } from '@/lib/utils/cn';

interface Props {
  items: FaqEntry[];
  /** Index opened on first render; -1 leaves everything collapsed. */
  defaultOpen?: number;
}

const { items, defaultOpen = 0 } = Astro.props;

// Ids have to be unique across the document, and a page may carry more than
// one accordion, so each instance gets its own prefix.
const uid = `faq-${Math.random().toString(36).slice(2, 8)}`;
---

{/* Single-open accordion: buttons with aria-expanded, panels that animate
    their real height (grid rows, see global.css) and are inert while closed so
    focus never lands in hidden content. */}
<div class="divide-y divide-hairline border-y border-hairline" data-accordion>
  {
    items.map((item, index) => {
      const isOpen = index === defaultOpen;
      const panelId = `${uid}-panel-${index}`;
      const buttonId = `${uid}-button-${index}`;

      return (
        <div>
          <h3>
            <button
              id={buttonId}
              type="button"
              aria-expanded={isOpen}
              aria-controls={panelId}
              data-accordion-trigger
              class="group flex min-h-[4.25rem] w-full items-center justify-between gap-6 py-5 text-left"
            >
              <span class="text-lg font-medium leading-snug text-ink transition-colors duration-200 group-hover:text-mint-300 sm:text-xl">
                {item.question}
              </span>

              <span
                aria-hidden="true"
                data-marker
                class={cn(
                  'flex h-9 w-9 shrink-0 items-center justify-center rounded-full border transition-[transform,border-color,background-color,color] duration-300 ease-surface',
                  isOpen
                    ? 'rotate-45 border-mint-500/50 bg-mint-500/10 text-mint-400'
                    : 'border-hairline-strong text-ink-muted group-hover:border-white/30 group-hover:text-ink',
                )}
              >
                <Plus className="h-4 w-4" />
              </span>
            </button>
          </h3>

          <div
            id={panelId}
            role="region"
            aria-labelledby={buttonId}
            data-accordion-panel
            data-open={isOpen ? 'true' : 'false'}
            inert={!isOpen}
          >
            <div>
              <p class="max-w-[62ch] pb-7 pr-14 text-ink-muted">{item.answer}</p>
            </div>
          </div>
        </div>
      );
    })
  }
</div>

<script>
  const OPEN = ['rotate-45', 'border-mint-500/50', 'bg-mint-500/10', 'text-mint-400'];
  const CLOSED = ['border-hairline-strong', 'text-ink-muted'];

  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((root) => {
    const triggers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-accordion-trigger]'));

    const paint = (openIndex: number) => {
      triggers.forEach((trigger, index) => {
        const isOpen = index === openIndex;
        const panel = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
        const marker = trigger.querySelector<HTMLElement>('[data-marker]');

        trigger.setAttribute('aria-expanded', String(isOpen));
        if (panel) {
          panel.dataset.open = String(isOpen);
          panel.inert = !isOpen;
        }
        marker?.classList.remove(...(isOpen ? CLOSED : OPEN));
        marker?.classList.add(...(isOpen ? OPEN : CLOSED));
      });
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        paint(isOpen ? -1 : index);
      });
    });
  });
</script>
