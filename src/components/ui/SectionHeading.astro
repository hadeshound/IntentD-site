---
import { cn } from '@/lib/utils/cn';

interface Props {
  /** Kept for callers; kickers above headings were retired in the redesign. */
  eyebrow?: string;
  /** Plain text; markup goes through the `title` slot instead. */
  title?: string;
  description?: string;
  /** Kept for callers; every heading aligns left. */
  align?: 'left' | 'right';
  class?: string;
  id?: string;
}

const { title, description, class: className, id } = Astro.props;

const hasDescription = Boolean(description) || Astro.slots.has('description');
---

{/* Section header used by every landing block: the heading carries its own
    weight, the lead sits under it at a readable measure, and an optional aside
    (a pair of actions) aligns to the baseline on wide screens. */}
<div class={cn('grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-12', className)}>
  <div class="lg:col-span-8">
    <h2 id={id} class="text-section-title text-balance">
      {Astro.slots.has('title') ? <slot name="title" /> : title}
    </h2>

    {
      hasDescription ? (
        <div class="mt-5 max-w-[58ch] text-lead text-ink-muted text-pretty">
          {Astro.slots.has('description') ? <slot name="description" /> : description}
        </div>
      ) : null
    }
  </div>

  {Astro.slots.has('aside') ? <div class="lg:col-span-4 lg:justify-self-end"><slot name="aside" /></div> : null}
</div>
