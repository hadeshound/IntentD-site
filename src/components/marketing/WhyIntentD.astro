---
import Reveal from '@/components/ui/Reveal.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getDictionary } from '@/i18n';
import { cn } from '@/lib/utils/cn';

const t = getDictionary().why;

// Spans are layout, not copy: a wide lead card, then a narrow/wide/narrow
// rhythm so the four statements do not read as four identical tiles.
const SPANS = ['lg:col-span-7', 'lg:col-span-5', 'lg:col-span-5', 'lg:col-span-7'] as const;

const ADVANTAGES = SPANS.map((span, index) => ({
  span,
  lead: index === 0,
  title: t.items[index]?.title ?? '',
  body: t.items[index]?.body ?? '',
  footnote: t.items[index]?.footnote ?? '',
}));
---

<section class="relative border-t border-hairline py-20 lg:py-32">
  <SectionHeading class="shell" title={t.title} description={t.description} />

  <div class="shell mt-14 grid gap-5 lg:mt-16 lg:grid-cols-12 lg:gap-6">
    {
      ADVANTAGES.map((item, index) => (
        <Reveal delay={index * 80} class={cn(item.span, 'flex')}>
          <article
            class={cn(
              'surface-card flex w-full flex-col p-7 lg:p-9',
              item.lead && 'surface-card-accent',
            )}
          >
            <h3 class={cn(item.lead ? 'text-[1.625rem] leading-tight tracking-tight' : 'text-card-title')}>
              {item.title}
            </h3>

            <p class="mt-3.5 max-w-[48ch] text-ink-muted">{item.body}</p>

            {item.footnote ? (
              <p class="mt-auto border-t border-hairline pt-6 font-mono text-xs leading-relaxed text-ink-faint">
                {item.footnote}
              </p>
            ) : null}
          </article>
        </Reveal>
      ))
    }
  </div>
</section>
