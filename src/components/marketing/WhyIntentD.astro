---
import { Database, Gauge, Lock, ShieldCheck } from 'lucide-react';

import Reveal from '@/components/ui/Reveal.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getDictionary, getLangFromUrl } from '@/i18n';
import { cn } from '@/lib/utils/cn';

const t = getDictionary(getLangFromUrl(Astro.url)).why;

// Icon, grid span and the accent flag are layout, not copy: the first card is
// the wide accented one, and the rest alternate around it.
const LAYOUT = [
  { icon: Lock, layout: 'lg:col-span-7', accent: true },
  { icon: Gauge, layout: 'lg:col-span-5 lg:mt-12', accent: false },
  { icon: ShieldCheck, layout: 'lg:col-span-5 lg:-mt-4', accent: false },
  { icon: Database, layout: 'lg:col-span-7 lg:mt-8', accent: false },
] as const;

const ADVANTAGES = LAYOUT.map((entry, index) => ({
  ...entry,
  title: t.items[index]?.title ?? '',
  body: t.items[index]?.body ?? '',
  footnote: t.items[index]?.footnote ?? '',
}));
---

<section class="relative py-24 lg:py-32">
  <SectionHeading class="shell" eyebrow={t.eyebrow} title={t.title} description={t.description} />

  <div class="shell mt-16 grid gap-6 lg:mt-20 lg:grid-cols-12 lg:gap-7">
    {
      ADVANTAGES.map((advantage, index) => {
        const Icon = advantage.icon;

        return (
          <Reveal delay={index * 100} class={advantage.layout}>
            <article
              class={cn(
                'surface-card surface-card-interactive flex h-full flex-col p-7 lg:p-9',
                advantage.accent && 'surface-card-accent',
              )}
            >
              {advantage.accent ? <div class="ambient-glow -left-12 -top-12 h-48 w-48 bg-mint-500/20" /> : null}

              <span
                class={cn(
                  'inline-flex h-11 w-11 items-center justify-center rounded-control border',
                  advantage.accent
                    ? 'border-mint-500/40 bg-mint-500/10 text-mint-400'
                    : 'border-hairline bg-white/[0.03] text-ink-muted',
                )}
              >
                <Icon className="h-5 w-5" aria-hidden="true" />
              </span>

              <h3 class="mt-6 text-card-title">{advantage.title}</h3>

              <p class="mt-3.5 text-[0.9375rem] leading-relaxed text-ink-muted">{advantage.body}</p>

              {
                advantage.footnote ? (
                  <p class="mt-auto pt-7 font-mono text-xs leading-relaxed text-ink-faint">{advantage.footnote}</p>
                ) : null
              }
            </article>
          </Reveal>
        );
      })
    }
  </div>
</section>
