---
import { ArrowRight } from 'lucide-react';

import AmbientGlow from '@/components/ui/AmbientGlow.astro';
import Button from '@/components/ui/Button.astro';
import { getDictionary } from '@/i18n';

const t = getDictionary().contact.section;
---

{/* Closing call to action of the landing page. The form itself lives only on
    /contact, so there is one place to write to us and no repeated copy here. */}
<section id="contact" class="relative py-24 lg:py-32">
  <AmbientGlow tone="violet" class="-left-24 top-10 h-80 w-80" />

  <div class="shell">
    <div class="surface-card flex flex-col gap-8 p-8 lg:flex-row lg:items-center lg:justify-between lg:p-12">
      <div class="max-w-xl">
        <p class="flex items-center gap-3">
          <span class="eyebrow">{t.eyebrow}</span>
          <span class="h-px w-12 bg-hairline-strong"></span>
        </p>

        <h2 class="mt-6 text-section-title">{t.title}</h2>

        <p class="mt-5 text-lg leading-relaxed text-ink-muted text-pretty">{t.body}</p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0">
        <Button href="/contact?topic=buy_data" size="lg">
          {t.cta}
          <ArrowRight className="h-4 w-4" aria-hidden="true" />
        </Button>
        <Button href="/contact?topic=support" variant="secondary" size="lg">{t.ctaSupport}</Button>
      </div>
    </div>
  </div>
</section>
