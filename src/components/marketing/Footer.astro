---
import Logo from '@/components/ui/Logo.astro';
import { getDictionary } from '@/i18n';
import { footerColumns, SUPPORT_EMAIL } from '@/lib/content/navigation';

const t = getDictionary();
const columns = footerColumns();

const year = new Date().getFullYear();
---

<footer class="relative mt-30 border-t border-hairline">
  <div class="shell grid gap-14 py-16 lg:grid-cols-[1.4fr_2fr] lg:py-20">
    <div class="space-y-6">
      <Logo />

      <p class="max-w-sm text-sm leading-relaxed text-ink-muted">{t.footer.tagline}</p>
    </div>

    <div class="grid gap-10 sm:grid-cols-3">
      {
        columns.map((column) => (
          <nav aria-label={column.title}>
            <h2 class="text-sm font-medium text-ink">{column.title}</h2>

            <ul class="mt-4 space-y-0.5">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="inline-block py-1.5 text-base text-ink-muted transition-colors duration-200 hover:text-ink">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="border-t border-hairline">
    <div class="shell flex flex-col gap-4 py-6 text-xs text-ink-faint sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {t.footer.copyright}</p>

      <p class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href={`mailto:${SUPPORT_EMAIL}`} class="transition-colors duration-200 hover:text-mint-300">
          {SUPPORT_EMAIL}
        </a>
        <span>{t.footer.badge}</span>
      </p>
    </div>
  </div>
</footer>
