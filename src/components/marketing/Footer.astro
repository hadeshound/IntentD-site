---
import Logo from '@/components/ui/Logo.astro';
import StatusIndicator from '@/components/ui/StatusIndicator.astro';
import { FOOTER_COLUMNS, SUPPORT_EMAIL } from '@/lib/content/navigation';

const year = new Date().getFullYear();
---

<footer class="relative mt-30 border-t border-hairline">
  <div class="shell grid gap-14 py-16 lg:grid-cols-[1.4fr_2fr] lg:py-20">
    <div class="space-y-6">
      <Logo />

      <p class="max-w-sm text-sm leading-relaxed text-ink-muted">
        Инфраструктура intent-данных: SDK для разработчиков расширений и
        чистый PII-free поток для аналитических команд.
      </p>

      <StatusIndicator />
    </div>

    <div class="grid gap-10 sm:grid-cols-3">
      {
        FOOTER_COLUMNS.map((column) => (
          <nav aria-label={column.title}>
            <h2 class="font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-ink-faint">{column.title}</h2>

            <ul class="mt-5 space-y-3">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-ink-muted transition-colors duration-200 hover:text-mint-300">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="border-t border-hairline">
    <div class="shell flex flex-col gap-4 py-6 text-xs text-ink-faint sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} IntentD. Все права защищены.</p>

      <p class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href={`mailto:${SUPPORT_EMAIL}`} class="transition-colors duration-200 hover:text-mint-300">
          {SUPPORT_EMAIL}
        </a>
        <span class="font-mono uppercase tracking-[0.14em]">PII-free · GDPR-safe</span>
      </p>
    </div>
  </div>
</footer>
