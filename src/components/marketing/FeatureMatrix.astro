---
import { Check, Minus } from 'lucide-react';

import { getDictionary } from '@/i18n';
import type { PlanCode } from '@/lib/api/plans';
import { featureMatrix, PLAN_ORDER, planPresentation } from '@/lib/content/pricing';

const dictionary = getDictionary();
const t = dictionary.pricing.matrix;

// Plan names are product names.
const COLUMN_TITLES: Record<PlanCode, string> = {
  starter: 'Starter',
  growth: 'Growth',
  scale: 'Scale',
  enterprise: 'Enterprise',
};

const groups = featureMatrix();

// A short form of the audience line under each column header.
const AUDIENCE_WORDS = 3;

function shortAudience(code: PlanCode): string {
  const full = planPresentation(code).audience;
  return full.split(' ').slice(0, AUDIENCE_WORDS).join(' ');
}
---

{/* Full comparison table for /pricing. It is a real <table> with scope-d
    headers so a screen reader announces "Growth · Delivery frequency · once an
    hour" instead of reading a wall of disconnected cells. */}
<section class="py-24 lg:py-28">
  <div class="shell">
    <p class="flex items-center gap-3">
      <span class="eyebrow">{t.eyebrow}</span>
      <span class="h-px w-12 bg-hairline-strong"></span>
    </p>

    <h2 class="mt-6 max-w-2xl text-section-title">{t.title}</h2>

    <div class="mt-12 overflow-x-auto rounded-card border border-hairline">
      <table class="w-full min-w-[52rem] border-collapse text-left">
        <caption class="sr-only">{t.caption}</caption>

        <thead>
          <tr class="border-b border-hairline bg-white/[0.02]">
            <th scope="col" class="px-6 py-5 text-sm font-medium text-ink-faint">{t.featureColumn}</th>

            {
              PLAN_ORDER.map((code) => (
                <th scope="col" class="px-6 py-5 text-center font-display text-base text-ink">
                  {COLUMN_TITLES[code]}
                  <span class="mt-1 block font-sans text-xs font-normal text-ink-faint">
                    {shortAudience(code)}
                  </span>
                </th>
              ))
            }
          </tr>
        </thead>

        {
          groups.map((group) => (
            <tbody>
              <tr class="border-b border-hairline bg-white/[0.015]">
                <th
                  scope="colgroup"
                  colspan={PLAN_ORDER.length + 1}
                  class="px-6 py-3 font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-mint-400"
                >
                  {group.title}
                </th>
              </tr>

              {group.rows.map((row) => (
                <tr class="border-b border-hairline last:border-b-0">
                  <th scope="row" class="px-6 py-4 text-sm font-normal text-ink">
                    {row.label}
                  </th>

                  {
                    PLAN_ORDER.map((code) => {
                      const value = row.values[code];

                      return (
                        <td class="px-6 py-4 text-center">
                          {
                            value === true ? (
                              <Fragment>
                                <Check className="mx-auto h-4 w-4 text-mint-400" aria-hidden="true" />
                                <span class="sr-only">{dictionary.a11y.included}</span>
                              </Fragment>
                            ) : value === false ? (
                              <Fragment>
                                <Minus className="mx-auto h-4 w-4 text-ink-faint" aria-hidden="true" />
                                <span class="sr-only">{dictionary.a11y.notIncluded}</span>
                              </Fragment>
                            ) : (
                              <span class="text-sm text-ink-muted">{value}</span>
                            )
                          }
                        </td>
                      );
                    })
                  }
                </tr>
              ))}
            </tbody>
          ))
        }
      </table>
    </div>
  </div>
</section>
