---
import Button from '@/components/ui/Button.astro';
import Reveal from '@/components/ui/Reveal.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getDictionary } from '@/i18n';

const dictionary = getDictionary();
const t = dictionary.useCases;

// The chips are schema field names, which are not translated.
const SIGNALS = [
  ['search_query', 'domain', 'clean_url'],
  ['anon_uid', 'geo_country', 'device_type'],
  ['timestamp', 'lang', 'domain'],
] as const;

const USE_CASES = SIGNALS.map((signals, index) => ({
  signals,
  segment: t.items[index]?.segment ?? '',
  title: t.items[index]?.title ?? '',
  body: t.items[index]?.body ?? '',
}));
---

<section id="use-cases" class="relative border-t border-hairline py-20 lg:py-32">
  <SectionHeading class="shell" title={t.heading}>
    <div slot="aside" class="grid w-full gap-3 sm:grid-cols-2">
      <Button href="/contact?topic=buy_data">{t.ctaSample}</Button>
      <Button href="/docs/api" variant="secondary">{t.cta}</Button>
    </div>
  </SectionHeading>

  <div class="shell mt-14 grid gap-5 lg:mt-16 lg:grid-cols-3 lg:gap-6">
    {
      USE_CASES.map((useCase, index) => (
        <Reveal delay={index * 90} class="h-full">
          <article class="surface-card flex h-full flex-col p-7 lg:p-8">
            <p class="inline-flex w-fit rounded-pill border border-mint-500/30 bg-mint-500/10 px-3 py-1 text-xs font-medium text-mint-300">
              {useCase.segment}
            </p>

            <h3 class="mt-6 text-card-title">{useCase.title}</h3>

            <p class="mt-3 text-ink-muted">{useCase.body}</p>

            <ul class="mt-auto flex flex-wrap gap-2 pt-8">
              {useCase.signals.map((signal) => (
                <li class="rounded-control border border-hairline bg-white/[0.03] px-2.5 py-1 font-mono text-xs text-ink-muted">
                  {signal}
                </li>
              ))}
            </ul>
          </article>
        </Reveal>
      ))
    }
  </div>
</section>
