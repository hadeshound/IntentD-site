---
import Reveal from '@/components/ui/Reveal.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getDictionary } from '@/i18n';

interface Props {
  /** Which audience's steps to show. */
  track: 'publishers' | 'buyers';
}

const { track } = Astro.props;

const t = getDictionary().howItWorks;
const steps = t[track].steps;
const title = track === 'publishers' ? t.titleDevelopers : t.titleBuyers;
---

{/* One audience, three steps. Each page shows only its own track, so the two
    sequences never repeat on the same URL. */}
<section id="how-it-works" class="relative border-t border-hairline py-20 lg:py-32">
  <SectionHeading class="shell" title={title} />

  <ol class="shell mt-12 grid gap-8 lg:mt-16 lg:grid-cols-3 lg:gap-10">
    {
      steps.map((step, index) => (
        <Reveal as="li" delay={index * 90}>
          <div class="border-t border-hairline-strong pt-6">
            <span class="font-mono text-sm text-mint-400">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-card-title">{step.title}</h3>
            <p class="mt-3 max-w-[38ch] text-ink-muted">{step.body}</p>
          </div>
        </Reveal>
      ))
    }
  </ol>
</section>
