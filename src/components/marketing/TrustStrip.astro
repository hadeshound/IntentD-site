---
import { Globe, ShieldCheck, Store, Timer, Zap } from 'lucide-react';

import { getDictionary } from '@/i18n';
import { cn } from '@/lib/utils/cn';

const t = getDictionary().hero;

const ICONS = { shield: ShieldCheck, chrome: Globe, store: Store, zap: Zap, timer: Timer } as const;

// One hue per fact, on the bare icon: no tile, no frame.
const TONES = {
  teal: 'text-mint-400',
  amber: 'text-amber-300',
  blue: 'text-violet-400',
  cyan: 'text-cyan-300',
  violet: 'text-indigo-300',
} as const;
---

{/* Proof points under the hero. Two columns on a phone, three on a tablet and a
    single row from 1024px up, where each item holds its text on one line. */}
<section aria-label="Key facts" class="border-y border-hairline bg-white/[0.015]">
  <ul class="shell grid grid-cols-2 gap-x-6 gap-y-5 py-7 sm:grid-cols-3 lg:flex lg:items-center lg:justify-between lg:gap-x-6">
    {
      t.strip.map((item) => {
        const Icon = ICONS[item.icon as keyof typeof ICONS];

        return (
          <li class="flex items-center gap-2.5 text-sm font-medium text-ink/90 lg:whitespace-nowrap">
            <Icon className={cn('h-5 w-5 shrink-0', TONES[item.tone as keyof typeof TONES])} aria-hidden="true" />
            {item.label}
          </li>
        );
      })
    }
  </ul>
</section>
