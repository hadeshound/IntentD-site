---
import { Database, Puzzle, ShieldCheck } from 'lucide-react';

import { getDictionary } from '@/i18n';
import { cn } from '@/lib/utils/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const t = getDictionary().flow;

// Stage copy comes from the dictionary: the extension, the edge filter and the
// delivery target. The SDK sits inside the extension, so it is not drawn twice.
const SOURCE = t.nodes[0];
const FILTER = t.nodes[2];
const TARGET = t.nodes[3];

// One straight flow, left to right, symmetric around the filter:
// extension -> filter -> storage. Before the filter the line is dim (raw events);
// after it carries the brand gradient (clean stream).
const W = 600;
const H = 222;
const CY = 70;
const ICON = 54;
const GAP = 38;
const STROKE = 5;

const X1 = 104;
const X2 = 300;
const X3 = 496;

const rawLine = `M${X1 + GAP} ${CY} H${X2 - GAP}`;
const cleanLine = `M${X2 + GAP} ${CY} H${X3 - GAP}`;
const wholeLine = `M${X1 + GAP} ${CY} H${X3 - GAP}`;

const PERIOD = 4.4;

// Every packet crosses the whole line: nothing is lost on the way. The filter
// cleans the data, and that shows as the packet changing colour at the shield.
const packets = [0, 0.9, 1.8, 2.7, 3.6];
---

{/* The hero visual. Packets travel along the line with SMIL, so it costs no
    JavaScript; they are hidden entirely when the visitor asks for reduced motion. */}
<figure class={cn('flow-figure relative m-0', className)}>
  <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label={t.alt}>
    <defs>
      <linearGradient id="flow-grad" x1={X2 + GAP} y1="0" x2={X3 - GAP} y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#35C4A6" />
        <stop offset="1" stop-color="#3A8FCB" />
      </linearGradient>
    </defs>

    {/* The flow: dim before the filter, in the brand gradient after it. */}
    <path d={rawLine} fill="none" stroke="rgba(199,208,219,0.38)" stroke-width={STROKE} stroke-linecap="round" />
    <path d={cleanLine} fill="none" stroke="url(#flow-grad)" stroke-width={STROKE} stroke-linecap="round" />

    {/* The three stages, as bare icons on the line. */}
    <Puzzle x={X1 - ICON / 2} y={CY - ICON / 2} size={ICON} strokeWidth={1.5} color="#C7D0DB" aria-hidden="true" />
    <ShieldCheck x={X2 - ICON / 2} y={CY - ICON / 2} size={ICON} strokeWidth={1.5} color="#52CDB2" aria-hidden="true" />
    <Database x={X3 - ICON / 2} y={CY - ICON / 2} size={ICON} strokeWidth={1.5} color="#6BAEE3" aria-hidden="true" />

    {/* Packets. */}
    <g class="flow-packets">
      {
        packets.map((begin) => (
          <circle r="4.5" fill="#E3EAF2" opacity="0">
            <animateMotion dur={`${PERIOD}s`} repeatCount="indefinite" begin={`${begin}s`} path={wholeLine} />
            <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur={`${PERIOD}s`} repeatCount="indefinite" begin={`${begin}s`} />
            <animate attributeName="fill" values="#E3EAF2;#E3EAF2;#7DF0D8;#7DF0D8" keyTimes="0;0.46;0.52;1" dur={`${PERIOD}s`} repeatCount="indefinite" begin={`${begin}s`} />
          </circle>
        ))
      }
    </g>

    {/* Labels, centred under each stage. */}
    <g font-family="var(--font-geist), system-ui, sans-serif" text-anchor="middle">
      <text x={X1} y={CY + 64} class="flow-title" font-size="17" font-weight="500" fill="#F5F7FA">{SOURCE?.title}</text>
      <text x={X1} y={CY + 84} class="flow-sub" font-size="14" fill="#98A2B3">{SOURCE?.subtitle}</text>

      <text x={X2} y={CY + 64} class="flow-title" font-size="17" font-weight="500" fill="#F5F7FA">{FILTER?.title}</text>
      <text x={X2} y={CY + 84} class="flow-sub" font-size="14" fill="#98A2B3">{FILTER?.subtitle}</text>

      <text x={X3} y={CY + 64} class="flow-title" font-size="17" font-weight="500" fill="#F5F7FA">{TARGET?.title}</text>
      <text x={X3} y={CY + 84} class="flow-sub" font-size="14" fill="#98A2B3">{TARGET?.subtitle}</text>
    </g>

    {/* Legend, centred under the whole picture. */}
    <g class="flow-legend" font-family="var(--font-geist), system-ui, sans-serif" font-size="14" fill="#98A2B3">
      <circle cx={X2 - 108} cy="196" r="4" fill="#E3EAF2" />
      <text x={X2 - 96} y="201">Raw events</text>
      <circle cx={X2 + 20} cy="196" r="4" fill="#52CDB2" />
      <text x={X2 + 32} y="201">Clean stream</text>
    </g>
  </svg>
</figure>

<style>
  /* The drawing keeps its left edge and grows to the right, into the free space
     beside the shell, as far as the screen allows (never past the viewport). */
  @media (min-width: 900px) {
    .flow-figure {
      width: calc(100% * 600 / 560);
      max-width: calc(100% + (100vw - min(84rem, 100vw)) / 2 + var(--shell-padding) - 1rem);
    }
  }

  /* On a phone the whole drawing is shown at about 58 percent, so the labels are
     set larger there, and the second line of each label is dropped. */
  @media (max-width: 639px) {
    .flow-title {
      font-size: 22px;
    }

    .flow-sub {
      display: none;
    }

    .flow-legend {
      font-size: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-packets {
      display: none;
    }
  }
</style>
