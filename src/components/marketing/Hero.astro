---
import { Plug } from 'lucide-react';

import Button from '@/components/ui/Button.astro';
import { getDictionary } from '@/i18n';
import { DASHBOARD_LINKS } from '@/lib/config/urls';
import DataFlowDiagram from './DataFlowDiagram.astro';

const t = getDictionary().hero;

---

{/* First viewport: the promise and its two actions on the left, the actual
    path a signal takes on the right. The diagram is the proof, so it holds half
    the width and aligns to the headline instead of floating below it. */}
<section class="relative overflow-hidden pb-16 pt-12 lg:pb-28 lg:pt-20">
  <div class="shell grid items-start gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-7">
      <h1 class="text-hero">
        {t.titleBefore} <span class="text-mint-400">{t.titleAccent}</span> {t.titleAfter}
      </h1>

      <p class="mt-7 max-w-[34rem] text-lead text-ink-muted text-pretty">{t.subtitle}</p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <Button href={`${DASHBOARD_LINKS.register}?role=publisher`} size="lg" class="sm:min-w-[15rem]">
          <Plug className="h-[1.125rem] w-[1.125rem]" aria-hidden="true" />
          {t.ctaPrimary}
        </Button>

        <Button href="/pricing" variant="secondary" size="lg">{t.ctaSecondary}</Button>
      </div>

    </div>

    <div class="lg:col-span-5 lg:mt-2">
      <DataFlowDiagram />
    </div>
  </div>
</section>
