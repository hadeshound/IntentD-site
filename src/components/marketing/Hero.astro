---
import { ArrowRight, Check, Zap } from 'lucide-react';

import Button from '@/components/ui/Button.astro';
import { getDictionary } from '@/i18n';
import { DASHBOARD_LINKS } from '@/lib/config/urls';
import DataFlowDiagram from './DataFlowDiagram.astro';

const t = getDictionary().hero;

// The first point is the speed claim; the other two are compliance marks.
const TRUST_ICONS = [Zap, Check, Check];
---

{/* First viewport: the promise and its two actions on the left, the actual
    path a signal takes on the right. The diagram is the proof, so it holds half
    the width and aligns to the headline instead of floating below it. */}
<section class="relative overflow-hidden pb-16 pt-12 lg:pb-32 lg:pt-24">
  <div class="shell grid items-center gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-7">
      <h1 class="text-hero">
        {t.titleBefore} <span class="text-mint-400">{t.titleAccent}</span> {t.titleAfter}
      </h1>

      <p class="mt-7 max-w-[34rem] text-lead text-ink-muted text-pretty">{t.subtitle}</p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <Button href={`${DASHBOARD_LINKS.register}?role=publisher`} size="lg" class="sm:min-w-[15rem]">
          {t.ctaPrimary}
          <ArrowRight className="h-4 w-4" aria-hidden="true" />
        </Button>

        <Button href="/contact?topic=buy_data" variant="secondary" size="lg">{t.ctaSecondary}</Button>
      </div>

      <ul class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 border-t border-hairline pt-8">
        {
          t.trust.map((label, index) => {
            const Icon = TRUST_ICONS[index] ?? Check;

            return (
              <li class="flex items-center gap-2.5 text-sm text-ink-muted">
                <Icon className="h-4 w-4 text-mint-400" aria-hidden="true" />
                {label}
              </li>
            );
          })
        }
      </ul>
    </div>

    <div class="lg:col-span-5">
      <DataFlowDiagram />
    </div>
  </div>
</section>
