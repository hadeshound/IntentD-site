---
import { ArrowRight, Database, Puzzle } from 'lucide-react';

import Button from '@/components/ui/Button.astro';
import Reveal from '@/components/ui/Reveal.astro';
import { getDictionary } from '@/i18n';

const t = getDictionary().pathSplit;

const PATHS = [
  { data: t.developers, icon: Puzzle, tone: 'text-mint-400', href: '/developers', secondaryHref: '/pricing', accent: true },
  { data: t.buyers, icon: Database, tone: 'text-violet-400', href: '/data-buyers', secondaryHref: '/docs/api', accent: false },
] as const;
---

{/* The two audiences each get their own page. The home page only routes them
    there: a short promise and a way in, nothing that the pages repeat. */}
<section class="relative py-20 lg:py-32">
  <div class="shell">
    <h2 class="max-w-[22ch] text-section-title text-balance">{t.title}</h2>

    <div class="mt-12 grid gap-5 lg:mt-16 lg:grid-cols-2 lg:gap-6">
      {
        PATHS.map((path, index) => {
          const Icon = path.icon;

          return (
            <Reveal delay={index * 90} class="flex">
              <article class={`surface-card flex w-full flex-col p-7 lg:p-10 ${path.accent ? 'surface-card-accent' : ''}`}>
                <Icon className={`h-8 w-8 ${path.tone}`} aria-hidden="true" />

                <h3 class="mt-7 text-[1.625rem] leading-tight tracking-tight">{path.data.title}</h3>
                <p class="mt-3.5 max-w-[46ch] text-ink-muted">{path.data.body}</p>

                <div class="mt-auto flex flex-col gap-3 pt-9 sm:flex-row">
                  <Button href={path.href}>
                    {path.data.cta}
                    <ArrowRight className="h-4 w-4" aria-hidden="true" />
                  </Button>
                  <Button href={path.secondaryHref} variant="secondary">{path.data.secondary}</Button>
                </div>
              </article>
            </Reveal>
          );
        })
      }
    </div>
  </div>
</section>
