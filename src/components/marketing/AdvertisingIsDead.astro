---
import { ArrowRight, Ban, ShieldCheck, TrendingDown } from 'lucide-react';

import Button from '@/components/ui/Button.astro';
import Reveal from '@/components/ui/Reveal.astro';
import { getDictionary } from '@/i18n';

const t = getDictionary().advertising;

const PROBLEMS = [TrendingDown, Ban].map((icon, index) => ({
  icon,
  title: t.cards[index]?.title ?? '',
  body: t.cards[index]?.body ?? '',
}));
const ANSWER = { title: t.cards[2]?.title ?? '', body: t.cards[2]?.body ?? '' };
---

{/* Problem and answer side by side: what goes wrong with ads in an extension
    on the left, what IntentD does instead on the right. Two blocks of equal
    height read as a before and after, with the heading above both. */}
<section id="publishers" class="relative border-t border-hairline py-20 lg:py-32">
  <div class="shell">
    <h2 class="max-w-[22ch] text-section-title text-balance">
      {t.titleBefore}{' '}<span class="text-ink-faint">{t.titleMuted}</span>
    </h2>

    <div class="mt-12 grid gap-5 lg:mt-16 lg:grid-cols-2 lg:gap-6">
      <Reveal class="flex">
        <div class="surface-card flex w-full flex-col divide-y divide-hairline p-2">
          {
            PROBLEMS.map((problem) => {
              const Icon = problem.icon;

              return (
                <div class="flex gap-5 p-6 lg:p-7">
                  <Icon className="mt-1 h-6 w-6 shrink-0 text-ink-faint" aria-hidden="true" />
                  <div>
                    <h3 class="text-card-title">{problem.title}</h3>
                    <p class="mt-2.5 text-ink-muted">{problem.body}</p>
                  </div>
                </div>
              );
            })
          }
        </div>
      </Reveal>

      <Reveal delay={90} class="flex">
        <div class="surface-card surface-card-accent flex w-full flex-col p-7 lg:p-9">
          <ShieldCheck className="h-8 w-8 text-mint-400" aria-hidden="true" />
          <h3 class="mt-6 text-[1.625rem] leading-tight tracking-tight">{ANSWER.title}</h3>
          <p class="mt-3.5 max-w-[44ch] text-ink-muted">{ANSWER.body}</p>

          <div class="mt-auto pt-8">
            <Button href="#how-it-works" variant="secondary">
              {t.cta}
              <ArrowRight className="h-4 w-4" aria-hidden="true" />
            </Button>
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</section>
