---
import { Ban, ShieldCheck, TrendingDown } from 'lucide-react';

import Reveal from '@/components/ui/Reveal.astro';
import { getDictionary } from '@/i18n';
import { cn } from '@/lib/utils/cn';

const t = getDictionary().advertising;

// Icon and the solution flag belong to the layout, not to the copy: two
// problems, then the answer.
const LAYOUT = [
  { icon: TrendingDown, isSolution: false },
  { icon: Ban, isSolution: false },
  { icon: ShieldCheck, isSolution: true },
] as const;

const ROWS = LAYOUT.map((layout, index) => ({
  ...layout,
  title: t.cards[index]?.title ?? '',
  body: t.cards[index]?.body ?? '',
}));
---

{/* Problem and answer as one reading list, not three cards: the heading holds
    the left column, and each statement is a row separated by a hairline. The
    last row is the answer and carries the only tint. */}
<section id="publishers" class="relative border-t border-hairline py-20 lg:py-32">
  <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <h2 class="text-section-title text-balance lg:sticky lg:top-28">
        {t.titleBefore}{' '}<span class="text-ink-faint">{t.titleMuted}</span>
      </h2>
    </div>

    <ol class="divide-y divide-hairline border-y border-hairline lg:col-span-7">
      {
        ROWS.map((row, index) => {
          const Icon = row.icon;

          return (
            <Reveal as="li" delay={index * 80}>
              <div class={cn('flex gap-5 py-8 sm:gap-6', row.isSolution && '-mx-5 bg-mint-500/[0.05] px-5 sm:-mx-7 sm:px-7')}>
                <span
                  class={cn(
                    'mt-0.5 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-control border',
                    row.isSolution
                      ? 'border-mint-500/40 bg-mint-500/10 text-mint-400'
                      : 'border-hairline bg-white/[0.03] text-ink-muted',
                  )}
                >
                  <Icon className="h-5 w-5" aria-hidden="true" />
                </span>

                <div class="min-w-0">
                  <h3 class="text-card-title">{row.title}</h3>
                  <p class="mt-2.5 max-w-[52ch] text-ink-muted">{row.body}</p>
                </div>
              </div>
            </Reveal>
          );
        })
      }
    </ol>
  </div>
</section>
