---
import { ArrowRight } from 'lucide-react';

import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getDictionary } from '@/i18n';
import type { Plan } from '@/lib/api/plans';
import { DASHBOARD_LINKS } from '@/lib/config/urls';
import { EARNINGS } from '@/lib/content/earnings';
import { PLAN_ORDER } from '@/lib/content/pricing';

interface Props {
  /** The subscriptions a developer can choose from. */
  plans: Plan[];
  /** The /calculator page renders its own h1, so it can suppress this heading. */
  showHeading?: boolean;
}

const { plans, showHeading = true } = Astro.props;

const t = getDictionary().calculator;

// The subscriptions that exist: price, setup fee and allowance come from the
// live catalogue, so the calculator can never drift from what is billed.
const tiers = [...plans]
  .filter((plan) => !plan.is_custom_priced && plan.users_limit)
  .sort((a, b) => PLAN_ORDER.indexOf(a.code) - PLAN_ORDER.indexOf(b.code))
  .map((plan) => ({
    code: plan.code,
    name: plan.name,
    monthly: plan.price_cents / 100,
    setup: plan.setup_price_cents / 100,
    allowance: plan.users_limit as number,
  }));

const defaultTier = tiers.find((tier) => tier.code === 'growth') ?? tiers[0];
---

{/* A profit calculator, like the one for the white-label platform: the chosen
    plan is a cost, income is what the visitor expects per consenting user, and
    the result can be a loss. */}
<section id="calculator" class={showHeading ? 'relative border-t border-hairline py-20 lg:py-32' : 'relative pb-20 lg:pb-32'}>
  {showHeading ? <SectionHeading class="shell" title={t.title} description={t.description} /> : null}

  <div
    class={showHeading ? 'shell mt-14 lg:mt-16' : 'shell'}
    data-calculator
    data-tiers={JSON.stringify(tiers)}
    data-min-users={EARNINGS.MIN_USERS}
    data-max-users={EARNINGS.MAX_USERS}
    data-default-users={EARNINGS.DEFAULT_USERS}
  >
    <div class="grid gap-5 lg:grid-cols-12 lg:gap-6">
      <div class="surface-card p-7 lg:col-span-7 lg:p-9">
        <fieldset>
          <legend class="font-medium text-ink">{t.plan}</legend>
          <div class="mt-4 grid grid-cols-3 gap-3">
            {
              tiers.map((tier) => (
                <label class="cursor-pointer">
                  <input type="radio" name="plan" value={tier.code} checked={tier.code === defaultTier?.code} class="peer sr-only" />
                  <span class="flex h-full flex-col rounded-control border border-hairline-strong bg-white/[0.03] px-4 py-3 transition-colors duration-200 hover:border-white/30 peer-checked:border-mint-500/60 peer-checked:bg-mint-500/10 peer-focus-visible:ring-2 peer-focus-visible:ring-mint-400">
                    <span class="font-medium text-ink">{tier.name}</span>
                    <span class="mt-0.5 text-sm text-ink-muted tabular">${tier.monthly.toLocaleString('en-US')}/mo</span>
                  </span>
                </label>
              ))
            }
          </div>
          <p class="mt-3 text-sm text-ink-muted" data-out-allowance></p>
        </fieldset>

        <div class="mt-10 space-y-9 border-t border-hairline pt-9">
          <div>
            <div class="flex items-baseline justify-between gap-4">
              <label for="calc-users" class="font-medium text-ink">{t.users}</label>
              <output data-out-users class="font-display text-xl font-semibold text-ink tabular"></output>
            </div>
            <input id="calc-users" type="range" min="0" max="1000" step="1" data-in-users class="calc-range mt-4 w-full" />
            <div class="mt-2 flex justify-between text-xs text-ink-faint">
              <span>1K</span><span>10K</span><span>100K</span><span>1M</span>
            </div>
          </div>

          <div>
            <div class="flex items-baseline justify-between gap-4">
              <label for="calc-consent" class="font-medium text-ink">{t.consent}</label>
              <output data-out-consent class="font-display text-xl font-semibold text-ink tabular"></output>
            </div>
            <input
              id="calc-consent"
              type="range"
              min={EARNINGS.MIN_CONSENT}
              max={EARNINGS.MAX_CONSENT}
              step="1"
              value={EARNINGS.DEFAULT_CONSENT}
              data-in-consent
              class="calc-range mt-4 w-full"
            />
            <p class="mt-3 text-sm text-ink-muted">{t.consentHint}</p>
          </div>

          <div>
            <div class="flex items-baseline justify-between gap-4">
              <label for="calc-revenue" class="font-medium text-ink">{t.revenue}</label>
              <output data-out-revenue-input class="font-display text-xl font-semibold text-ink tabular"></output>
            </div>
            <input
              id="calc-revenue"
              type="range"
              min={EARNINGS.MIN_REVENUE_PER_USER}
              max={EARNINGS.MAX_REVENUE_PER_USER}
              step="0.01"
              value={EARNINGS.DEFAULT_REVENUE_PER_USER}
              data-in-revenue
              class="calc-range mt-4 w-full"
            />
            <p class="mt-3 text-sm text-ink-faint">{t.revenueHint}</p>
          </div>
        </div>
      </div>

      <div class="calc-result flex flex-col rounded-card border border-mint-500/30 p-7 lg:sticky lg:top-24 lg:col-span-5 lg:self-start lg:p-9" aria-live="polite">
        <p class="text-sm font-medium text-mint-300">{t.resultLabel}</p>
        <p class="mt-3 font-display text-5xl font-semibold tracking-tight text-ink tabular lg:text-6xl" data-out-net>$0</p>
        <p class="mt-1 text-ink-muted" data-out-verdict>{t.perMonth}</p>

        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-white/10 pt-7">
          <div>
            <dt class="text-sm text-ink-muted">{t.income}</dt>
            <dd class="mt-1 font-display text-xl font-semibold text-ink tabular" data-out-income>$0</dd>
          </div>
          <div>
            <dt class="text-sm text-ink-muted"><span data-out-plan>{t.planCost}</span></dt>
            <dd class="mt-1 font-display text-xl font-semibold text-ink tabular" data-out-cost>$0</dd>
          </div>
          <div>
            <dt class="text-sm text-ink-muted">{t.consenting}</dt>
            <dd class="mt-1 font-display text-xl font-semibold text-ink tabular" data-out-consenting>0</dd>
          </div>
          <div>
            <dt class="text-sm text-ink-muted">{t.firstYear}</dt>
            <dd class="mt-1 font-display text-xl font-semibold text-ink tabular" data-out-year>$0</dd>
          </div>
        </dl>

        <ul class="mt-6 space-y-2.5 border-t border-white/10 pt-6 text-sm">
          <li class="flex justify-between gap-4"><span class="text-ink-muted">{t.breakEven}</span><span class="text-right font-medium text-ink tabular" data-out-breakeven></span></li>
          <li class="flex justify-between gap-4"><span class="text-ink-muted">{t.payback}</span><span class="text-right font-medium text-ink" data-out-payback></span></li>
        </ul>

        <div class="mt-6 border-t border-white/10 pt-6">
          <p class="text-sm font-medium text-ink">{t.compareTitle}</p>
          <ul class="mt-3 space-y-2 text-sm" data-out-compare></ul>
        </div>

        <p class="mt-6 text-sm text-ink-faint">{t.disclaimer}</p>

        <div class="mt-auto pt-8">
          <Button href={`${DASHBOARD_LINKS.register}?role=publisher`} size="lg" class="w-full">
            {t.cta}
            <ArrowRight className="h-4 w-4" aria-hidden="true" />
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .calc-result {
    background:
      radial-gradient(120% 90% at 0% 0%, rgba(53, 196, 166, 0.16), transparent 60%),
      linear-gradient(160deg, #0f1c22 0%, #0b1118 100%);
  }

  .calc-result.is-loss {
    border-color: rgba(248, 113, 113, 0.4);
    background:
      radial-gradient(120% 90% at 0% 0%, rgba(248, 113, 113, 0.14), transparent 60%),
      linear-gradient(160deg, #1d1315 0%, #0f0b0e 100%);
  }

  .calc-range {
    -webkit-appearance: none;
    appearance: none;
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(90deg, #35c4a6 var(--fill, 0%), rgba(255, 255, 255, 0.12) var(--fill, 0%));
    outline: none;
    cursor: pointer;
  }

  .calc-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    height: 22px;
    width: 22px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid #35c4a6;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .calc-range::-moz-range-thumb {
    height: 18px;
    width: 18px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid #35c4a6;
  }

  .calc-range:focus-visible {
    outline: 2px solid #52cdb2;
    outline-offset: 6px;
  }
</style>

<script>
  interface Tier {
    code: string;
    name: string;
    monthly: number;
    setup: number;
    allowance: number;
  }

  const root = document.querySelector<HTMLElement>('[data-calculator]');

  if (root) {
    const tiers = JSON.parse(root.dataset.tiers ?? '[]') as Tier[];
    const minUsers = Number(root.dataset.minUsers);
    const maxUsers = Number(root.dataset.maxUsers);
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

    const usersIn = q<HTMLInputElement>('[data-in-users]');
    const consentIn = q<HTMLInputElement>('[data-in-consent]');
    const revenueIn = q<HTMLInputElement>('[data-in-revenue]');
    const card = q<HTMLElement>('.calc-result');

    const money = (n: number) => (n < 0 ? '−' : '') + '$' + Math.round(Math.abs(n)).toLocaleString('en-US');
    const cents = (n: number) => '$' + n.toFixed(2);
    const int = (n: number) => Math.round(n).toLocaleString('en-US');

    // The slider is logarithmic: 1K to 1M reads evenly, and values snap to
    // round numbers so the label never shows 47,318 users.
    const toUsers = (pos: number) => {
      const raw = minUsers * Math.pow(maxUsers / minUsers, pos / 1000);
      const step = raw < 10_000 ? 500 : raw < 100_000 ? 5_000 : 25_000;
      return Math.min(maxUsers, Math.max(minUsers, Math.round(raw / step) * step));
    };
    const toPos = (users: number) => Math.round((Math.log(users / minUsers) / Math.log(maxUsers / minUsers)) * 1000);

    const fill = (el: HTMLInputElement) => {
      const pct = ((Number(el.value) - Number(el.min)) / (Number(el.max) - Number(el.min))) * 100;
      el.style.setProperty('--fill', `${pct}%`);
    };

    const selected = (): Tier => {
      const code = root.querySelector<HTMLInputElement>('input[name="plan"]:checked')?.value;
      return tiers.find((tier) => tier.code === code) ?? tiers[0]!;
    };

    const render = () => {
      const tier = selected();
      const users = toUsers(Number(usersIn.value));
      const consent = Number(consentIn.value);
      const perUser = Number(revenueIn.value);
      const consenting = Math.round((users * consent) / 100);

      const net = (t: Tier) => consenting * perUser - t.monthly;
      const income = consenting * perUser;
      const result = net(tier);

      q('[data-out-users]').textContent = int(users);
      q('[data-out-consent]').textContent = `${consent}%`;
      q('[data-out-revenue-input]').textContent = cents(perUser);
      q('[data-out-income]').textContent = money(income);
      q('[data-out-plan]').textContent = `${tier.name} plan`;
      q('[data-out-cost]').textContent = money(tier.monthly);
      q('[data-out-consenting]').textContent = int(consenting);
      q('[data-out-year]').textContent = money(result * 12 - tier.setup);

      const netEl = q('[data-out-net]');
      netEl.textContent = money(result);
      card.classList.toggle('is-loss', result < 0);
      q('[data-out-verdict]').textContent = result < 0 ? 'loss per month' : result > 0 ? 'profit per month' : 'break-even per month';

      // Coverage: each plan includes a number of monthly active users.
      const over = users > tier.allowance;
      const allowance = q('[data-out-allowance]');
      allowance.textContent = over
        ? `${tier.name} includes up to ${int(tier.allowance)} active users. Your ${int(users)} need a larger plan.`
        : `${tier.name} includes up to ${int(tier.allowance)} active users. Setup is ${money(tier.setup)}, one-off.`;
      allowance.classList.toggle('text-red-300', over);
      allowance.classList.toggle('text-ink-muted', !over);

      // Break-even: how many consenting users cover the subscription.
      const needed = perUser > 0 ? Math.ceil(tier.monthly / perUser) : 0;
      q('[data-out-breakeven]').textContent =
        perUser > 0 ? `${int(needed)} consenting (${int((needed * 100) / consent)} active users)` : '—';

      q('[data-out-payback]').textContent =
        tier.setup === 0 ? 'no setup fee' : result > 0 ? `${Math.max(1, Math.ceil(tier.setup / result))} month(s)` : 'not at these numbers';

      const list = q('[data-out-compare]');
      list.innerHTML = '';
      tiers.forEach((t) => {
        const value = net(t);
        const li = document.createElement('li');
        li.className = 'flex items-center justify-between gap-3 ' + (t.code === tier.code ? 'text-ink' : 'text-ink-muted');
        const name = document.createElement('span');
        name.textContent = users > t.allowance ? `${t.name} (too small)` : t.name;
        const amount = document.createElement('span');
        amount.className = 'tabular font-medium ' + (value < 0 ? 'text-red-300' : '');
        amount.textContent = `${money(value)} / mo`;
        li.append(name, amount);
        list.append(li);
      });

      fill(usersIn);
      fill(consentIn);
      fill(revenueIn);
      usersIn.setAttribute('aria-valuetext', `${int(users)} users`);
    };

    usersIn.value = String(toPos(Number(root.dataset.defaultUsers) || 50_000));
    [usersIn, consentIn, revenueIn].forEach((el) => el.addEventListener('input', render));
    root.querySelectorAll('input[name="plan"]').forEach((el) => el.addEventListener('change', render));
    render();
  }
</script>
