---
import { ArrowRight, Check } from 'lucide-react';

import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { getDictionary } from '@/i18n';
import type { Plan } from '@/lib/api/plans';
import { planPresentation } from '@/lib/content/pricing';
import { cn } from '@/lib/utils/cn';
import { formatPrice, usersAllowance } from '@/lib/utils/format';
import { buildRegisterRedirect } from '@/lib/utils/redirect';

interface Props {
  plan: Plan;
  /** Index in the grid; drives the vertical offset on wide screens. */
  index: number;
}

const { plan, index } = Astro.props;

const t = getDictionary().pricing;
const presentation = planPresentation(plan.code);

// Enterprise is quoted per deal, so its CTA goes to sales rather than to
// checkout. Everything else sends an anonymous visitor to registration with
// the plan carried along, and a signed-in one straight to checkout. The card
// is server-rendered in the anonymous state and SessionBridge rewrites
// data-auth-href once the silent refresh has settled -- which is the same
// decision useAuth() made in the client component this replaces.
const contactHref = '/contact?topic=enterprise';
const anonymousHref = plan.is_custom_priced
  ? contactHref
  : buildRegisterRedirect(plan.code);
const authenticatedHref = plan.is_custom_priced
  ? null
  : `/checkout?plan=${plan.code}`;

const isHighlighted = presentation.highlighted;
const ctaLabel = plan.is_custom_priced ? t.cta.contactSales : t.cta.subscribe;

// The grid holds four cards; the last one keeps the staggered rhythm.
const offsetClass = !isHighlighted && index === 3 ? 'lg:mt-8' : undefined;

// A plan quoted per deal has no published allowance; a catalogue that predates
// migration 000015 has none either, and that line is simply left out rather
// than filled with a number nobody promised.
const allowance = usersAllowance(plan.users_limit);
const volumeLabel = plan.is_custom_priced
  ? t.customVolume
  : allowance.kind === 'limited'
    ? `${allowance.text} ${t.activeUsers}`
    : allowance.kind === 'unlimited'
      ? allowance.text
      : null;
---

<article
  class={cn(
    'surface-card surface-card-interactive flex flex-col p-7 lg:p-8',
    isHighlighted && 'surface-card-accent lg:-mt-6 lg:mb-6',
    offsetClass,
  )}
>
  {isHighlighted ? <div class="ambient-glow -right-14 -top-16 h-56 w-56 bg-mint-500/25" /> : null}

  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="font-display text-xl text-ink">{plan.name}</h3>
      <p class="mt-2 max-w-[16rem] text-sm leading-relaxed text-ink-faint">{presentation.audience}</p>
    </div>

    {
      isHighlighted && presentation.highlightLabel ? (
        <Badge tone="mint">{presentation.highlightLabel}</Badge>
      ) : null
    }
  </div>

  <p class="mt-8 flex items-baseline gap-2">
    <span class="font-display text-4xl tracking-tight text-ink lg:text-[2.75rem]">
      {formatPrice(plan.price_cents, plan.currency)}
    </span>
    {plan.is_custom_priced ? null : <span class="text-sm text-ink-faint">{t.perMonth}</span>}
  </p>

  {/* The setup fee is a second, one-off number: it belongs next to the price
      rather than buried in the feature list, because it changes what the first
      invoice looks like. */}
  {
    plan.setup_price_cents > 0 ? (
      <p class="mt-2 text-sm text-ink-muted">
        + {formatPrice(plan.setup_price_cents, plan.currency)}{' '}
        <span class="text-ink-faint">{t.setupFee}</span>
      </p>
    ) : null
  }

  {
    volumeLabel ? (
      <p class="mt-3 font-mono text-xs uppercase tracking-[0.14em] text-ink-faint">{volumeLabel}</p>
    ) : null
  }

  <ul class="mt-8 space-y-3.5 border-t border-hairline pt-8">
    {
      presentation.features.map((feature) => (
        <li class="flex gap-3 text-[0.9375rem] leading-relaxed text-ink-muted">
          <Check
            className={cn('mt-1 h-4 w-4 shrink-0', isHighlighted ? 'text-mint-400' : 'text-mint-500/70')}
            aria-hidden="true"
          />
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>

  <div class="mt-auto pt-9">
    <Button
      href={anonymousHref}
      data-auth-href={authenticatedHref}
      variant={isHighlighted ? 'primary' : 'secondary'}
      size="lg"
      class="w-full"
    >
      {ctaLabel}
      <ArrowRight className="h-4 w-4" aria-hidden="true" />
    </Button>
  </div>
</article>
