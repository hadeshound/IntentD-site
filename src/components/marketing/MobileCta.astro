---
import { MessageSquare } from 'lucide-react';

import Button from '@/components/ui/Button.astro';
import { getDictionary } from '@/i18n';
import { routePath } from '@/lib/utils/pathname';

const t = getDictionary().nav;

// The contact page and the auth/checkout flows already are the destination.
const route = routePath(Astro.url.pathname);
const hidden = route.startsWith('/contact') || route.startsWith('/auth') || route.startsWith('/checkout');
---

{
  !hidden && (
    <>
      {/* Spacer so the fixed bar never covers the footer's last line. */}
      <div class="h-20 lg:hidden [@media(max-height:500px)]:hidden" aria-hidden="true" />
      <div
        data-mobile-cta
        class="fixed inset-x-0 bottom-0 z-40 border-t border-hairline bg-void/90 px-4 py-3 backdrop-blur-xl transition-transform duration-300 lg:hidden [@media(max-height:500px)]:hidden"
      >
        <Button href="/contact" class="w-full justify-center">
          <MessageSquare className="h-4 w-4" aria-hidden="true" />
          {t.talkToUs}
        </Button>
      </div>
    </>
  )
}
