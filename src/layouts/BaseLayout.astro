---
// Self-hosted type; --font-* variables are declared in global.css so
// tailwind.config.ts carries over unchanged. Each package's index.css declares
// its subsets with a unicode-range per face, so a reader only downloads the
// files their text actually needs.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';

import '@/styles/global.css';

import SessionBridge from '@/components/auth/SessionBridge.astro';
import { SITE_URL } from '@/lib/config/urls';
import { routePath } from '@/lib/utils/pathname';

interface Props {
  /** Page title without the suffix; the site name is appended here. */
  title: string;
  /** Set for the landing page, whose title is the full string. */
  titleTemplate?: boolean;
  description: string;
  keywords?: string[];
  /** Extra structured data for the page (FAQPage and the like). */
  jsonLd?: object[];
  /** Mirrors the Next `robots: { index: false }` metadata on private pages. */
  noindex?: boolean;
  /** Skips the canonical when the URL carries query parameters. */
  canonical?: string;
}

const {
  title,
  titleTemplate = true,
  description,
  noindex = false,
  canonical,
  jsonLd: pageJsonLd = [],
} = Astro.props;

const fullTitle = titleTemplate ? `${title} · IntentD` : title;

const route = routePath(Astro.url.pathname);
const canonicalUrl = canonical ?? new URL(route, SITE_URL).href;
const ogImage = new URL('/og-image.png', SITE_URL).href;
const ogAlt = 'IntentD — monetize browser extensions without ads';

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'IntentD',
  url: `${SITE_URL}/`,
  logo: new URL('/favicon-192.png', SITE_URL).href,
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'IntentD',
  url: `${SITE_URL}/`,
};
const breadcrumbs =
  route === '/' || noindex
    ? []
    : [
        {
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'IntentD', item: `${SITE_URL}/` },
            { '@type': 'ListItem', position: 2, name: title, item: canonicalUrl },
          ],
        },
      ];
const structuredData = noindex ? [] : [organization, website, ...breadcrumbs, ...pageJsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080B10" />
    <meta name="color-scheme" content="dark" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* A canonical on a noindex page points crawlers at something we have
        just asked them to ignore, so the private routes and 404 skip it. */}
    {noindex ? null : <link rel="canonical" href={canonicalUrl} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="IntentD" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    {structuredData.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>

  <body class="min-h-screen">
    <slot />

    <SessionBridge />

    <script>
      // Scroll reveal, formerly lib/hooks/useReveal.ts. One observer for the
      // whole page instead of one per element; the class pair, the threshold and
      // the root margin are the hook's. Reveal is one-way -- re-animating on
      // scroll-back is the jumpy behaviour this design explicitly avoids.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      const showAll = () => targets.forEach((element) => element.classList.add('reveal-visible'));

      // Without the API (or with reduced motion), show the content immediately.
      if (
        typeof IntersectionObserver === 'undefined' ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        showAll();
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
        );

        targets.forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>
