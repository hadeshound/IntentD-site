---
import AuthShell from '@/components/auth/AuthShell.astro';
import { ResetPasswordForm } from '@/components/auth/ResetPasswordForm';
import MarketingLayout from '@/layouts/MarketingLayout.astro';

// The reset token arrives in the query string, so the page is rendered per
// request rather than prerendered.
export const prerender = false;

const token = Astro.url.searchParams.get('token') ?? '';
---

<MarketingLayout
  title="Новый пароль"
  description="Установите новый пароль для аккаунта IntentD по ссылке из письма."
  noindex
>
  <AuthShell
    eyebrow="Новый пароль"
    title="Установите новый пароль"
    description="Придумайте пароль, которого ещё не было у этого аккаунта. Ссылка сработает только один раз."
  >
    <ResetPasswordForm token={token} client:load />

    <p slot="footer">
      Ссылка устарела?{' '}
      <a href="/auth/forgot-password" class="link-underline underline underline-offset-4">Запросить новую</a>
    </p>
  </AuthShell>
</MarketingLayout>
