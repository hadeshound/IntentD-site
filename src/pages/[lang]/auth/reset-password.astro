---
// Prefixed route for every language except the default one. The body is the
// same screen the English route renders; it reads the language off the URL.
//
// This one is rendered per request, so `[lang]` is not constrained by
// getStaticPaths and would otherwise match any segment at all -- /nonsense/
// included. Those get the not-found screen with a real 404 status. Rewriting
// to /404 is not an option: Astro refuses to rewrite an on-demand route onto a
// prerendered one, and a redirect would answer 200 at the destination.
import Screen from '@/screens/auth/reset-password.astro';
import NotFound from '@/screens/not-found.astro';
import { DEFAULT_LANG, isLang } from '@/i18n';

export const prerender = false;

const { lang } = Astro.params;
const isKnownLanguage = isLang(lang) && lang !== DEFAULT_LANG;

if (!isKnownLanguage) {
  Astro.response.status = 404;
}
---

{isKnownLanguage ? <Screen /> : <NotFound />}
