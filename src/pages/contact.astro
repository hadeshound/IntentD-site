---
import { ContactForm } from '@/components/marketing/ContactForm';
import FaqSection from '@/components/marketing/FaqSection.astro';
import AmbientGlow from '@/components/ui/AmbientGlow.astro';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { CONTACT_FAQ } from '@/lib/content/faq';
import { PRIVACY_EMAIL, SALES_EMAIL, SUPPORT_EMAIL } from '@/lib/content/navigation';
import { Clock, Mail, ShieldCheck } from 'lucide-react';

const DIRECT_CHANNELS = [
  { icon: Mail, label: 'Продажи и доступ к данным', email: SALES_EMAIL },
  { icon: ShieldCheck, label: 'Приватность и DPA', email: PRIVACY_EMAIL },
  { icon: Mail, label: 'Техническая поддержка', email: SUPPORT_EMAIL },
];

const description =
  'Свяжитесь с командой IntentD: доступ к потоку данных, подключение расширения, техническая поддержка и вопросы по обработке данных.';
---

{/* The Enterprise pricing CTA arrives here with ?topic=enterprise. The page is
    prerendered, so the form island reads that parameter itself. */}
<MarketingLayout title="Контакты" description={description}>
  <section class="relative overflow-hidden pb-20 pt-16 lg:pb-28 lg:pt-24">
    <div class="hairline-grid-overlay"></div>
    <AmbientGlow class="-left-24 top-4 h-96 w-96" drift />
    <AmbientGlow tone="violet" class="right-0 top-48 h-72 w-72" />

    <div class="shell grid gap-14 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <p class="flex items-center gap-3">
          <span class="eyebrow">Контакты</span>
          <span class="h-px w-12 bg-hairline-strong"></span>
        </p>

        <h1 class="mt-7 text-section-title">Напишите нам</h1>

        <p class="mt-7 max-w-md text-lg leading-relaxed text-ink-muted text-pretty">
          Опишите задачу максимально конкретно: какой сегмент данных нужен, какой
          объём, в какие сроки. Так первый же ответ будет по делу.
        </p>

        <div class="surface-card mt-10 p-6">
          <div class="flex items-start gap-4">
            <span class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-control border border-hairline bg-white/[0.03] text-mint-400">
              <Clock className="h-4 w-4" aria-hidden="true" />
            </span>

            <div>
              <h2 class="text-base text-ink">Время ответа</h2>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">
                Заявки на доступ к данным — в течение рабочего дня. Технические
                обращения от подключённых издателей — по приоритету тарифа.
              </p>
            </div>
          </div>
        </div>

        <ul class="mt-8 space-y-3">
          {
            DIRECT_CHANNELS.map((channel) => {
              const Icon = channel.icon;

              return (
                <li class="flex items-center gap-3 text-sm">
                  <Icon className="h-4 w-4 shrink-0 text-ink-faint" aria-hidden="true" />
                  <span class="text-ink-muted">{channel.label}</span>
                  <a
                    href={`mailto:${channel.email}`}
                    class="ml-auto font-mono text-xs text-mint-400 transition-colors duration-200 hover:text-mint-300"
                  >
                    {channel.email}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="lg:col-span-6 lg:col-start-7 lg:mt-10">
        <div class="surface-card p-7 lg:p-9">
          <h2 class="font-display text-xl text-ink">Форма обращения</h2>
          <p class="mt-2 text-sm text-ink-muted">Все поля, кроме компании, обязательны.</p>

          <div class="mt-8">
            <ContactForm client:load />
          </div>
        </div>
      </div>
    </div>
  </section>

  <FaqSection
    items={CONTACT_FAQ}
    eyebrow="Перед обращением"
    title="Что стоит знать заранее"
    id="contact-faq"
  />
</MarketingLayout>
