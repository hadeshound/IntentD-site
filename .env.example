# ---------------------------------------------------------------------------
# IntentD public site (Astro)
#
# No environment variables are required to build or run this site.
#
# Production URLs are hardcoded in src/lib/config/urls.ts and switch on
# import.meta.env.PROD automatically:
#
#   prod:  https://intentd.net              https://api.intentd.net/api/v1
#          https://app.intentd.net
#   dev:   http://localhost:4321            http://localhost:8080/api/v1
#          http://localhost:3001
#
# This file is kept only as documentation of the URLs that matter. If a
# staging domain is ever introduced, do it in src/lib/config/urls.ts
# rather than through env variables.
# --------------------------------------------------------------------------