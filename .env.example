# Base URL of the Go portal API. Must match CORS_ALLOWED_ORIGINS on the backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Canonical site origin, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dashboard origin. Sign-in and account links on this site point here.
# local: http://localhost:3001   production: https://app.intentd.io
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
